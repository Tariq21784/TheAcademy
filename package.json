{
  "name": "theacademy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:static": "tsc && vite build --outDir docs",
    "preview": "vite preview",
    "server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^3.10.111",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.19",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.13.6",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.1"
  }
}
